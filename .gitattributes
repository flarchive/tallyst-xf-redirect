# Keep distributed package lean: ship only runtime files (+ compiled js/dist).
# Dev/build files are excluded from `composer archive` and registry tarballs.
/.gitattributes   export-ignore
/.gitignore       export-ignore
/js/node_modules  export-ignore
/js/src           export-ignore
/js/admin.js      export-ignore
/js/package.json  export-ignore
/js/package-lock.json export-ignore
/js/webpack.config.js export-ignore
